# ==============================================================================
# Backend Server Configuration
# ==============================================================================
PORT=5000
NODE_ENV=development

# Allowed Frontend URL for CORS (e.g. http://localhost:3000 or https://your-site.netlify.app)
FRONTEND_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# ==============================================================================
# Database Configuration (PostgreSQL with Prisma ORM)
# ==============================================================================
# Local PostgreSQL: postgresql://<username>:<password>@localhost:5432/<database_name>
# Neon / Supabase: postgresql://<username>:<password>@<host>.neon.tech/<database_name>?sslmode=require
DATABASE_URL="postgresql://postgres:your_db_password@localhost:5432/rakhi_gift_db"

# ==============================================================================
# Admin Authentication
# ==============================================================================
ADMIN_EMAIL=admin@rakhigift.me
# Bcrypt hash for admin password (Default for 'password': $2a$10$92IXUNpkjO0rOQ5byMi.Ye4oKoEa3Ro9llC/.og/at2.uheWG/igi)
ADMIN_PASSWORD_HASH=$2a$10$92IXUNpkjO0rOQ5byMi.Ye4oKoEa3Ro9llC/.og/at2.uheWG/igi
JWT_SECRET=sample_super_secure_jwt_secret_key_2026_dev

# ==============================================================================
# Cloudinary Configuration (Cloud Image Storage)
# ==============================================================================
CLOUDINARY_CLOUD_NAME=sample_cloud_name
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=sample_cloudinary_api_secret_abcdef

# ==============================================================================
# Razorpay Payment Gateway Configuration
# ==============================================================================
# Test Key: rzp_test_... | Live Key: rzp_live_...
RAZORPAY_KEY_ID=rzp_test_sampleKeyId123456
RAZORPAY_KEY_SECRET=sample_razorpay_key_secret_12345
# Webhook Secret configured in Razorpay Dashboard -> Webhooks
RAZORPAY_WEBHOOK_SECRET=sample_webhook_secret_AdQX1TAFHn
