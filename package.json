{
  "name": "rakhi-memory-gift",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:server": "node server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "postinstall": "prisma generate --schema=server/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema=server/prisma/schema.prisma",
    "db:generate": "prisma generate --schema=server/prisma/schema.prisma",
    "test:smoke": "node server/utils/productionSmokeTest.js"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "@react-three/fiber": "^8.18.0",
    "bcryptjs": "^2.4.3",
    "canvas-confetti": "^1.9.4",
    "cloudinary": "^2.10.1",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.477.0",
    "math-intrinsics": "^1.1.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.23.0",
    "prisma": "^6.4.1",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.2.0"
  }
}
