# ==============================================================================
# Frontend Environment Variables (Vite)
# ==============================================================================

# Backend API Base URL (Use relative '/api' for local development with Vite proxy,
# or full URL for standalone production deployment e.g. https://your-backend.onrender.com/api)
VITE_API_BASE_URL=http://localhost:5000/api

# Razorpay Key ID for client-side checkout (Public Key ID)
# Test Mode: rzp_test_sample12345678 | Live Mode: rzp_live_sample12345678
VITE_RAZORPAY_KEY_ID=rzp_test_sampleKeyId123456
